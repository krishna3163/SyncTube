# Backend
PORT=10000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Keep process-local watch-party state consistent; clustering is an explicit opt-in.
CLUSTER=0
# Set to 1 to browse the offline Cinema fixture catalogue (sample movies/series/anime + local streams)
MOVIEBOX_FIXTURE=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Frontend
VITE_API_URL=http://localhost:10000
VITE_SOCKET_URL=http://localhost:10000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# Hybrid WebRTC P2P + Mediasoup SFU Calling
CALL_TOPOLOGY_MODE=hybrid # Options: hybrid (P2P for 2, SFU for 3+), sfu_only, p2p_only, disabled
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40200
MEDIASOUP_NUM_WORKERS=0 # 0 sets auto-detection based on host CPU cores
MEDIASOUP_LOG_LEVEL=warn

# STUN / TURN Configuration (NAT and restricted firewall traversal)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
